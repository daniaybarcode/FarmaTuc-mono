# PostgreSQL
POSTGRES_DB=farmatuc
POSTGRES_USER=farmatuc
POSTGRES_PASSWORD=cambiar_en_produccion
DB_PORT=5432

# API
API_PORT=3000
API_SECRET_KEY=cambiar_en_produccion

# Autenticación JWT
# JWT_SECRET: secreto para firmar tokens. REQUERIDO en producción (si NODE_ENV=production y no se define, la API no arranca).
# En desarrollo usa un default no seguro solo para pruebas locales.
JWT_SECRET=cambiar_en_produccion
# Tiempo de expiración del token (formato jsonwebtoken: 8h, 7d, 60m, etc.)
JWT_EXPIRES_IN=8h

# Web
WEB_PORT=80
