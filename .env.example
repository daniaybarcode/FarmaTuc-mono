# PostgreSQL
POSTGRES_DB=farmatuc
POSTGRES_USER=farmatuc
POSTGRES_PASSWORD=cambiar_en_produccion
DB_PORT=5432

# API
API_PORT=3000
API_SECRET_KEY=cambiar_en_produccion

# Autenticación JWT
# JWT_SECRET: secreto para firmar tokens. REQUERIDO en producción (si NODE_ENV=production y no se define, la API no arranca).
# En desarrollo usa un default no seguro solo para pruebas locales.
JWT_SECRET=cambiar_en_produccion
# Tiempo de expiración del token (formato jsonwebtoken: 8h, 7d, 60m, etc.)
JWT_EXPIRES_IN=8h

# Web
WEB_PORT=80

# Licenciamiento offline (archivo firmado Ed25519, validación local)
# LICENSING_PUBLIC_KEY_PATH: clave pública del emisor para VALIDAR licencias.
# OBLIGATORIA en producción (si NODE_ENV=production y no se define, la API no arranca).
# En dev apunta a las claves de ejemplo versionadas en apps/api/keys/.
LICENSING_PUBLIC_KEY_PATH=./keys/dev-public.pem
# LICENSING_PRIVATE_KEY_PATH: SOLO en el despliegue del DUEÑO (emisor). Las
# instalaciones de farmacia NO la tienen (solo la pública).
LICENSING_PRIVATE_KEY_PATH=./keys/dev-private.pem
# LICENSING_EMITTER: habilita POST /api/licencias/emitir. false en farmacias.
LICENSING_EMITTER=false
